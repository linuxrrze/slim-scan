[Desktop Entry]
Type=Application
Name=Slim Scan
GenericName=Document Scanner
GenericName[de]=Dokumentenscanner
Comment=Scan documents from a network scanner into PDF files
Comment[de]=Dokumente von einem Netzwerkscanner als PDF-Dateien scannen
Exec=slim-scan-gui
Icon=io.github.linuxrrze.SlimScan
Terminal=false
Categories=Graphics;Scanning;Office;GTK;
Keywords=scan;scanner;pdf;document;wsd;epson;
Keywords[de]=scannen;scanner;pdf;dokument;einscannen;wsd;epson;
StartupNotify=true
StartupWMClass=io.github.linuxrrze.SlimScan
X-GNOME-UsesNotifications=true
