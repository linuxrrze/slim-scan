msgid "Open Slim Scan"
msgstr "Slim Scan öffnen"

#: scanform.py:523
msgid "Slim Scan in the status bar"
msgstr "Slim Scan in der Statusleiste"

#: scanform.py:579 scanform.py:606
msgid "Choose a scanner"
msgstr "Scanner wählen"

#: scanform.py:579
msgid "Several scanners found"
msgstr "Mehrere Scanner gefunden"

#: scanform.py:581
msgid "Several scanners are on the network. Choose yours in the preferences."
msgstr "Im Netzwerk sind mehrere Scanner. Wählen Sie Ihren in den Einstellungen."

#: scanform.py:582
msgid "Choose Scanner"
msgstr "Scanner wählen"

#: scanform.py:585 scanform.py:585
msgid "No scanner set up"
msgstr "Kein Scanner eingerichtet"

#: scanform.py:587
msgid "None found automatically on the network"
msgstr "Im Netzwerk wurde keiner automatisch gefunden"

#: scanform.py:588
msgid "No scanner is set up, and none was found on the network. Add your scanner in the preferences."
msgstr "Es ist kein Scanner eingerichtet, und im Netzwerk wurde keiner gefunden. Fügen Sie Ihren Scanner in den Einstellungen hinzu."

#: scanform.py:590
msgid "Add Scanner"
msgstr "Scanner hinzufügen"

#: scanform.py:593
msgid "Not available through SANE as {device}"
msgstr "Über SANE als {device} nicht verfügbar"

#: scanform.py:594 scanform.py:586
msgid "SANE finds no scanner"
msgstr "SANE findet keinen Scanner"

#: scanform.py:596
msgid "Not reachable at {host}"
msgstr "Unter {host} nicht erreichbar"

#: scanform.py:597
msgid "Not found on the network"
msgstr "Im Netzwerk nicht gefunden"

#: scanform.py:599
msgid "Scanner not reachable"
msgstr "Scanner nicht erreichbar"

#: scanform.py:600
msgid "{where} · trying again"
msgstr "{where} · neuer Versuch folgt"

#: scanform.py:601
msgid "“{name}” is not reachable. Check that it is switched on and connected; it is looked for again automatically."
msgstr "„{name}“ ist nicht erreichbar. Prüfen Sie, ob er eingeschaltet und verbunden ist; er wird automatisch erneut gesucht."

#: scanform.py:603
msgid "Retry"
msgstr "Erneut versuchen"

#: scanform.py:607
msgid "Several scanners match “{name}”. Set its address in the preferences."
msgstr "Mehrere Scanner passen zu „{name}“. Legen Sie seine Adresse in den Einstellungen fest."

#: scanform.py:611
msgid "Scanner error"
msgstr "Scannerfehler"

#: scanform.py:612
msgid "“{name}” could not be used (see below). Check its settings in the preferences."
msgstr "„{name}“ konnte nicht verwendet werden (siehe unten). Prüfen Sie seine Einstellungen."

#: scanform.py:614
msgid "The scanner could not be used (see below)."
msgstr "Der Scanner konnte nicht verwendet werden (siehe unten)."

#: scanform.py:619
msgid "Idle"
msgstr "Bereit"

#: scanform.py:619
msgid "Busy"
msgstr "Beschäftigt"

#: scanform.py:619
msgid "Stopped"
msgstr "Angehalten"
